#!/usr/bin/env python3
from __future__ import annotations
import json
import os
import sys
import time
from pathlib import Path

if 'app-server' not in sys.argv[1:]:
    print('fake-codex only supports app-server', file=sys.stderr)
    raise SystemExit(2)

scenario = os.environ.get('FAKE_CODEX_SCENARIO', 'success')
reset_sent = False
store_path = os.environ.get('FAKE_CODEX_RESET_STORE')
redeemed = json.loads(Path(store_path).read_text()) if store_path and Path(store_path).exists() else []

for raw in sys.stdin:
    try:
        request = json.loads(raw)
    except Exception:
        continue
    method = request.get('method')
    request_id = request.get('id')
    if request_id is None:
        continue
    if os.environ.get('FAKE_CODEX_REQUEST_LOG'):
        with open(os.environ['FAKE_CODEX_REQUEST_LOG'], 'a') as log:
            log.write(json.dumps(request) + '\n')

    if scenario == 'timeout':
        time.sleep(30)
        continue

    if method == 'initialize':
        client_info = request.get('params', {}).get('clientInfo', {})
        expected_client = {
            'name': 'agents_tray_limits_gnome',
            'title': 'Agents Tray Limits for GNOME',
            'version': '3.0.0',
        }
        if client_info != expected_client:
            response = {
                'id': request_id,
                'error': {'code': -32602, 'message': 'Unexpected clientInfo'},
            }
        else:
            response = {
                'id': request_id,
                'result': {'serverInfo': {
                    'name': 'fake-codex',
                    'version': '1.0.0',
                    'codexHome': os.environ.get('CODEX_HOME'),
                    'argv': sys.argv[1:],
                }},
            }
    elif method == 'account/read':
        if scenario == 'logged-out':
            account = None
        elif scenario == 'api-key':
            account = {'type': 'apiKey'}
        else:
            account = {
                'type': 'chatgpt',
                'email': os.environ.get('FAKE_CODEX_EMAIL', 'evgeny@example.com'),
                'planType': 'pro',
            }
        response = {
            'id': request_id,
            'result': {'account': account, 'requiresOpenaiAuth': True},
        }
    elif method == 'account/rateLimits/read':
        if scenario == 'old-codex':
            response = {'id': request_id, 'error': {'code': -32601, 'message': 'Method not found'}}
        elif scenario == 'reset-read-failed' and reset_sent:
            response = {'id': request_id, 'error': {'code': -32000, 'message': 'Read failed'}}
        else:
            primary_used = float(os.environ.get('FAKE_CODEX_USED', '27'))
            secondary_used = float(os.environ.get('FAKE_CODEX_SECONDARY', '61'))
            credit_count = int(os.environ.get('FAKE_CODEX_CREDITS', '2'))
            if redeemed:
                primary_used = secondary_used = 0
                credit_count = max(0, credit_count - len(redeemed))
            response = {
                'id': request_id,
                'result': {
                    'rateLimits': {
                        'limitId': 'codex',
                        'limitName': None,
                        'primary': {'usedPercent': 27, 'windowDurationMins': 300, 'resetsAt': 1893456000},
                        'secondary': {'usedPercent': 61, 'windowDurationMins': 10080, 'resetsAt': 1893974400},
                        'rateLimitReachedType': None,
                    },
                    'rateLimitsByLimitId': {
                        'codex': {
                            'limitId': 'codex',
                            'limitName': None,
                            'primary': {'usedPercent': 27, 'windowDurationMins': 300, 'resetsAt': 1893456000},
                            'secondary': {'usedPercent': 61, 'windowDurationMins': 10080, 'resetsAt': 1893974400},
                            'rateLimitReachedType': None,
                        },
                        'codex_other': {
                            'limitId': 'codex_other',
                            'limitName': 'Code review',
                            'primary': {'usedPercent': 9, 'windowDurationMins': 60, 'resetsAt': 1893456000},
                            'secondary': None,
                            'rateLimitReachedType': None,
                        },
                    },
                    'rateLimitResetCredits': {'availableCount': 2, 'credits': []},
                },
            }
            for bucket in [response['result']['rateLimits'], response['result']['rateLimitsByLimitId']['codex']]:
                bucket['primary']['usedPercent'] = primary_used
                bucket['secondary']['usedPercent'] = secondary_used
            response['result']['rateLimitResetCredits']['availableCount'] = credit_count
            if 'FAKE_CODEX_CREDIT_DETAILS' in os.environ:
                response['result']['rateLimitResetCredits']['credits'] = json.loads(os.environ['FAKE_CODEX_CREDIT_DETAILS'])
    elif method == 'account/rateLimitResetCredit/consume':
        reset_sent = True
        key = request.get('params', {}).get('idempotencyKey')
        if scenario == 'reset-unsupported':
            response = {'id': request_id, 'error': {'code': -32601, 'message': 'Method not found'}}
        else:
            outcome = {'reset-no-credit': 'noCredit', 'reset-nothing': 'nothingToReset'}.get(scenario, 'reset')
            if key in redeemed:
                outcome = 'alreadyRedeemed'
            elif outcome == 'reset':
                redeemed.append(key)
                if store_path:
                    Path(store_path).write_text(json.dumps(redeemed))
                if scenario == 'reset-timeout':
                    time.sleep(5)
            response = {'id': request_id, 'result': {'outcome': outcome}}
    elif method == 'account/usage/read':
        if scenario == 'no-usage':
            response = {'id': request_id, 'error': {'code': -32601, 'message': 'Method not found'}}
        else:
            response = {
                'id': request_id,
                'result': {
                    'summary': {
                        'lifetimeTokens': 1234567,
                        'peakDailyTokens': 45678,
                        'longestRunningTurnSec': 540,
                        'currentStreakDays': 8,
                        'longestStreakDays': 14,
                    },
                    'dailyUsageBuckets': [
                        {'startDate': '2026-08-20', 'tokens': 12345},
                        {'startDate': '2026-08-21', 'tokens': 23456},
                    ],
                },
            }
    else:
        response = {'id': request_id, 'error': {'code': -32601, 'message': 'Method not found'}}

    print(json.dumps(response), flush=True)
