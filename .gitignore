# Release output
/build/
/dist/
/*.zip
/*.sha256

# Compiled schemas and language artifacts
/schemas/gschemas.compiled
/locale/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# JavaScript
node_modules/
npm-debug.log*

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local visual-development output
/art-source/
/previews/
/contact-sheets/

# Version 18 animation build output. Keep the source art, Blender rigs,
# configuration, and compact motion fixtures; omit generated frame dumps,
# duplicate runtime sprites, Blender backups, and review-only previews.
/tools/animation-rig/v18/render/*/raw/
/tools/animation-rig/v18/render/*/sprites/
/tools/animation-rig/v18/previews/
/tools/animation-rig/v18/rigs/*.blend1
