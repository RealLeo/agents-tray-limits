{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realleo.github.io/agents-tray-limits/contracts/profile-document-v1.schema.json",
  "title": "Agents Tray Limits profile document",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profiles"],
  "properties": {
    "version": {"const": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "label", "configDir"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "provider": {"enum": ["codex", "claude"]},
        "label": {"type": "string", "minLength": 1},
        "configDir": {
          "type": "string",
          "anyOf": [
            {"const": ""},
            {"pattern": "^/"},
            {"pattern": "^~/"}
          ]
        }
      }
    }
  }
}
