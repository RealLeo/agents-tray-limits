{
  "version": 2,
  "id": "fallout-3",
  "name": "Fallout 3 — Pip-Boy 3000",
  "description": "The earlier bright green CRT-inspired interface retained from version 3.",
  "platforms": {
    "gnome": {"stylesheet": "theme.css"},
    "macos": {
      "layout": "pipboy-3000",
      "palette": {
        "background": "#020A03FF",
        "surface": "#071809FF",
        "primary": "#4AFF69FF",
        "secondary": "#24B845FF",
        "text": "#8DFF9CFF",
        "muted": "#4E9D5BFF",
        "warning": "#D4E84DFF",
        "critical": "#FF5D4AFF"
      },
      "typography": {"family": "monospaced", "scale": 1.0}
    }
  },
  "art": {
    "good": "assets/good.png",
    "worried": "assets/worried.png",
    "critical": "assets/critical.png",
    "dead": "assets/dead.png"
  },
  "animation": {
    "intervalMs": 140,
    "steps": [
      {"x": 0, "y": 0, "opacity": 255, "scale": 1.00},
      {"x": 0, "y": -1, "opacity": 246, "scale": 1.00},
      {"x": 1, "y": -1, "opacity": 255, "scale": 1.01},
      {"x": 1, "y": 0, "opacity": 250, "scale": 1.01},
      {"x": 0, "y": 1, "opacity": 255, "scale": 1.00},
      {"x": -1, "y": 1, "opacity": 244, "scale": 0.99},
      {"x": -1, "y": 0, "opacity": 255, "scale": 0.99},
      {"x": 0, "y": 0, "opacity": 250, "scale": 1.00}
    ]
  }
}
